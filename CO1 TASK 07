
#include <stdio.h>

int main()
{
    int a, b;
    float result;
    double amount;

    printf("Enter First Number: ");
    scanf("%d", &a);

    printf("Enter Second Number: ");
    scanf("%d", &b);

    if (b == 0)
    {
        printf("Division by zero is not allowed!");
        return 1;
    }

    printf("Integer Division: %d\n", a / b);

    result = (float)a / b;

    printf("Float Division: %.2f\n", result);

    amount = (double)a / b;

    printf("Double Division: %.4lf\n", amount);

    printf("Type Cast Result: %d\n", (int)amount);

    return 0;
}
