
#include <stdio.h>

int main()
{
    int house;
    unsigned int units;
    long bill_paise;

    printf("Enter House Number: ");

    if (scanf("%d", &house) != 1)
    {
        printf("Invalid House Number!");
        return 1;
    }

    printf("Enter Units: ");

    if (scanf("%u", &units) != 1)
    {
        printf("Invalid Units!");
        return 1;
    }

    bill_paise = 5000 + (long)units * 225;

    printf("\nHouse Number: %d\n", house);
    printf("Units: %u\n", units);

    printf("Total Bill: Rs %ld.%02ld\n",
           bill_paise / 100,
           bill_paise % 100);

    return 0;
}
